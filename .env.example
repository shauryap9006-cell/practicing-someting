# Copy to .env locally. Never commit real credentials.
RAILTWIN_ENV=development
RAILTWIN_JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
RAILTWIN_ALLOW_SYNTHETIC_FALLBACK=false
RAILTWIN_CORS_ORIGINS=["http://localhost:5173"]
RAILTWIN_OPENWA_WEBHOOK_SECRET=
RAILTWIN_RAPIDAPI_KEY=
RAILTWIN_SMS_API_KEY=

# Storage (override when mounting an external volume)
# RAILTWIN_DB_PATH=/app/data/railtwin.db

# Reverse proxy: only enable when nginx/traefik sets X-Forwarded-For
RAILTWIN_TRUST_PROXY_HEADERS=false

# Demo controls (must be false in production)
RAILTWIN_DEMO_ALLOW_CLOCK_CONTROL=true

# Domain defaults
RAILTWIN_DEFAULT_STATION_CODE=NDLS
RAILTWIN_DEFAULT_JUNCTION_CODE=CNB
RAILTWIN_DEMO_DEFAULT_TRAIN_NO=12301
RAILTWIN_DEMO_DEFAULT_DESTINATION_CODE=LKO
RAILTWIN_DEMO_DEFAULT_RUN_DATE=
RAILTWIN_DELAY_ON_TIME_MAX_MIN=15
RAILTWIN_DELAY_MODERATE_MAX_MIN=60
RAILTWIN_TELEMETRY_STALE_SECONDS=900
RAILTWIN_MIN_PASSWORD_LENGTH=12

# Notification sandbox (required only when RAILTWIN_NOTIFY_DEMO_MODE=true)
RAILTWIN_NOTIFY_DEMO_MODE=false
RAILTWIN_NOTIFY_DEMO_CONTROLLER_PHONE=
RAILTWIN_NOTIFY_DEMO_FIELD_PHONE=
